<!DOCTYPE html>
<html>

<header>
  <%- include('../partials/head')%>
</header>


<body class="container">
    <header>
      <%- include('../partials/header')%>
    </header>

  <main>

    <% if (currentUser) { %>
     <div class="welcome-message">
       <h2>Welcome, <%= currentUser.name.first %> <%= currentUser.name.last %>!</h2>
     </div>
    <% } %>


    <div class="jumbotron">
      <!--page to display all the users-->
      <h2>All Students</h2>
        <!-- Update page 11 lab15-->

          <ul>
            <!-- for each user-->
            <% users.forEach(function(user) { %>
              <li>
                <!-- create a link which directs to our /profile route and provides the username for tha user-->
                <!-- display the users title, first and last name as the link text -->
                <a href="/profile?username=<%= user.login.username %>"> <%= user.name.title+" "+user.name.first+" "+ user.name.last %> </a>
                <a href="/updateuser?username=<%= user.login.username %>">[Edit]</a>

              </li>
            <% }); %>
          </ul>


    </div>
  </main>


  <footer>
    <%- include('../partials/footer')%>
  </footer>

</body>

</html>